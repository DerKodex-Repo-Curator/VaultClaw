# VaultClaw Environment Configuration
#
# Quick start:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in values you need (leave unused sections commented)
#   3. Never commit .env to git — it is already in .gitignore
#
# Env precedence (highest → lowest):
#   process env → ./.env → ~/.vaultclaw/.env → vaultclaw.json `env` block
#
# For Docker: env vars are passed directly via docker-compose.yml
# For daemons: copy to ~/.vaultclaw/.env

# =============================================================================
# Gateway Authentication
# =============================================================================

# Required if the gateway binds beyond loopback (lan or 0.0.0.0).
# Generate a strong token: openssl rand -hex 32
VAULTCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# Alternative: use a password instead of a token (use one or the other).
# VAULTCLAW_GATEWAY_PASSWORD=change-me-to-a-strong-password

# =============================================================================
# Path Overrides (optional)
# =============================================================================

# Override the VaultClaw state directory (default: ~/.vaultclaw)
# VAULTCLAW_STATE_DIR=~/.vaultclaw

# Override config file path (default: ~/.vaultclaw/vaultclaw.json)
# VAULTCLAW_CONFIG_PATH=~/.vaultclaw/vaultclaw.json

# Override home directory detection
# VAULTCLAW_HOME=~

# Import missing keys from your login shell profile on startup.
# Useful if your shell sets vars like PATH or credential helpers.
# VAULTCLAW_LOAD_SHELL_ENV=1
# VAULTCLAW_SHELL_ENV_TIMEOUT_MS=15000

# =============================================================================
# LLM Provider API Keys
# Set at least one. VaultClaw will use whichever are configured.
# =============================================================================

# Anthropic — Claude models (recommended: Claude Opus 4.6)
# Get key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — GPT-4o, GPT-4-turbo, o1, o3
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Google — Gemini 2.0 Flash, Gemini 1.5 Pro
# Get key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=...

# OpenRouter — 100+ models via unified API
# Get key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# AWS Bedrock — Claude, Llama, Mistral via AWS
# Configure via AWS credentials / IAM role (no key needed if using instance role)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# MINIMAX_API_KEY=...

# =============================================================================
# Messaging Channels
# Configure only the channels you want to enable.
# =============================================================================

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# ── Discord ───────────────────────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=...

# ── Slack ─────────────────────────────────────────────────────────────────────
# Create an app at https://api.slack.com/apps (enable Socket Mode)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# ── Mattermost ────────────────────────────────────────────────────────────────
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com

# ── Zalo (Vietnam) ────────────────────────────────────────────────────────────
# ZALO_BOT_TOKEN=...

# ── Twitch ────────────────────────────────────────────────────────────────────
# VAULTCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# =============================================================================
# Tools & Media APIs (optional)
# =============================================================================

# ── Web Search ────────────────────────────────────────────────────────────────
# Brave Search API — used by the web search tool
# Get key at: https://brave.com/search/api/
# BRAVE_API_KEY=...

# Perplexity — AI-powered search
# PERPLEXITY_API_KEY=pplx-...

# Firecrawl — web scraping and crawling
# FIRECRAWL_API_KEY=...

# ── Voice ─────────────────────────────────────────────────────────────────────
# ElevenLabs — text-to-speech synthesis
# ELEVENLABS_API_KEY=...
# XI_API_KEY=...   # alias for ElevenLabs

# Deepgram — speech-to-text
# DEEPGRAM_API_KEY=...
